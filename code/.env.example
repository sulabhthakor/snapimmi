# ═══════════════════════════════════════════════════════════════
# SnapImmi Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env (local dev) or .env.docker (Docker)

# ─────────────────────────────────────────────────────────────────
# Database (Required)
# ─────────────────────────────────────────────────────────────────
# Local: postgresql://postgres:root@localhost:5432/visa_saas?schema=public
# Docker: postgresql://postgres:password@postgres:5432/visa_saas
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─────────────────────────────────────────────────────────────────
# Authentication (Required)
# ─────────────────────────────────────────────────────────────────
AUTH_SECRET="generate-a-secure-random-string-here"
AUTH_TRUST_HOST=true
# AUTH_URL is auto-detected from request origin - only set in Docker

# ─────────────────────────────────────────────────────────────────
# Redis (Optional - for production caching)
# ─────────────────────────────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────────
# Storage - MinIO/S3 (Optional)
# ─────────────────────────────────────────────────────────────────
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET="visa-documents"

# ─────────────────────────────────────────────────────────────────
# Email - SMTP (Optional)
# ─────────────────────────────────────────────────────────────────
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_FROM="noreply@example.com"
